# Copy of this file becomes config/pr-merge-notify.env (chmod 600). Keep it private.
GH_USER=your-github-username
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# How often to check. Any systemd time span (e.g. 1min, 5min, 60s).
# After changing, re-run ./install.sh to regenerate the timer.
POLL_INTERVAL=1min

# Optional: only needed if the systemd service can't read gh's keyring token.
# Use a token with `repo` scope, and authorize it for each SSO org.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
